
local Env = getgenv()

--==================================================
-- CLEAN UP PREVIOUS SCANNER
--==================================================

if Env.AetherFishScanner then
    local Previous = Env.AetherFishScanner
    Previous.Running = false

    for _, Connection in pairs(Previous.Connections or {}) do
        pcall(function()
            Connection:Disconnect()
        end)
    end

    for _, Marker in pairs(Previous.LocationMarkers or {}) do
        pcall(function()
            Marker:Destroy()
        end)
    end

    if Previous.MarkerFolder then
        pcall(function()
            Previous.MarkerFolder:Destroy()
        end)
    end

    for _, Hitbox in pairs(Previous.SpawnedFish or {}) do
        pcall(function()
            local Model = Hitbox:FindFirstAncestorOfClass("Model")
            if Model then
                local Highlight = Model:FindFirstChild("AetherFishHighlight")
                local Tracker = Model:FindFirstChild("AetherFishTracker")

                if Highlight then Highlight:Destroy() end
                if Tracker then Tracker:Destroy() end
            end
        end)
    end

    print("[FISH SCANNER] Previous instance disconnected.")
end

--==================================================
-- SERVICES
--==================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local HttpService = game:GetService("HttpService")
local StarterGui = game:GetService("StarterGui")
local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")

local Event = ReplicatedStorage.packages.Net["RE/RoamingFish/Update"]
local FishFolder = Workspace.active:WaitForChild("roamingFish")

local FishLibrary = require(
    ReplicatedStorage.shared.modules.library.fish
)

--==================================================
-- CONFIGURATION
--==================================================

local WEBHOOK_URL = "PASTE_YOUR_NEW_WEBHOOK_URL_HERE"

local ENABLE_WEBHOOK = true
local ENABLE_HIGHLIGHT = true
local ENABLE_TRACKER = true
local ENABLE_LAST_KNOWN_LOCATION = true

local LOCATION_UPDATE_INTERVAL = 0.15

--==================================================
-- SCANNER DATA
--==================================================

local Scanner = {
    Running = true,
    Connections = {},

    FishDatabase = {},
    SpawnedFish = {},

    LastPrinted = {},
    Notified = {},

    LastKnownLocations = {},
    LocationMarkers = {}
}

Env.AetherFishScanner = Scanner

--==================================================
-- PERSISTENT MARKER FOLDER
--==================================================

local MarkerFolder = Instance.new("Folder")
MarkerFolder.Name = "AetherPersistentMarkers"
MarkerFolder.Parent = Workspace

Scanner.MarkerFolder = MarkerFolder

--==================================================
-- NOTIFICATIONS
--==================================================

local function SendNotification(Text, Duration)

    pcall(function()
        local TemporarySound = Instance.new("Sound")
        TemporarySound.SoundId = "rbxassetid://96524940709824"
        TemporarySound.Parent = CoreGui
        TemporarySound:Play()

        task.delay(5, function()
            TemporarySound:Destroy()
        end)
    end)

    if ENABLE_WEBHOOK
        and WEBHOOK_URL ~= ""
        and not string.find(
            WEBHOOK_URL,
            "PASTE_YOUR_NEW_WEBHOOK_URL_HERE",
            1,
            true
        )
    then
        task.spawn(function()
            pcall(function()
                local Payload = {
                    content = "@everyone - " .. tostring(Text),
                    allowed_mentions = {
                        parse = {"everyone"}
                    }
                }

                local Response = request({
                    Url = WEBHOOK_URL,
                    Method = "POST",
                    Headers = {
                        ["Content-Type"] = "application/json"
                    },
                    Body = HttpService:JSONEncode(Payload)
                })

                if Response.StatusCode ~= 204
                    and Response.StatusCode ~= 200 then

                    warn(
                        "[FISH SCANNER] Webhook error:",
                        Response.StatusCode,
                        Response.Body
                    )
                end
            end)
        end)
    end

    return StarterGui:SetCore("SendNotification", {
        Title = "ALERT",
        Text = Text,
        Duration = Duration or 15
    })
end

--==================================================
-- FISH INFORMATION
--==================================================

local function GetRarity(FishName)
    local FishData = FishLibrary[FishName]

    if typeof(FishData) == "table" then
        return FishData.Rarity
    end

    return nil
end

local function GetFishModel(Hitbox)
    if not Hitbox then
        return nil
    end

    return Hitbox:FindFirstAncestorOfClass("Model")
end

local function IsSpecial(Data)
    if not Data then
        return false
    end

    local Rarity = GetRarity(Data.Name or "")

    return Data.Mutation == "Aether"
        or Rarity == "Divine Secret"
end

--==================================================
-- PERSISTENT LOCATION MARKER
--==================================================

local function CreatePersistentMarker(FishID)
    local Marker = Scanner.LocationMarkers[FishID]

    if Marker and Marker.Parent then
        return Marker
    end

    Marker = Instance.new("Part")
    Marker.Name = "LastKnown_" .. tostring(FishID)
    Marker.Size = Vector3.new(2, 2, 2)
    Marker.Shape = Enum.PartType.Ball
    Marker.Material = Enum.Material.Neon
    Marker.Color = Color3.fromRGB(190, 0, 255)
    Marker.Anchored = true
    Marker.CanCollide = false
    Marker.CanTouch = false
    Marker.CanQuery = false
    Marker.Transparency = 0.2
    Marker.Parent = MarkerFolder

    local Billboard = Instance.new("BillboardGui")
    Billboard.Name = "LocationLabel"
    Billboard.Size = UDim2.fromOffset(300, 90)
    Billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    Billboard.AlwaysOnTop = true
    Billboard.Adornee = Marker
    Billboard.Parent = Marker

    local Label = Instance.new("TextLabel")
    Label.Name = "Label"
    Label.Size = UDim2.fromScale(1, 1)
    Label.BackgroundTransparency = 1
    Label.TextColor3 = Color3.fromRGB(230, 170, 255)
    Label.TextStrokeTransparency = 0
    Label.TextScaled = true
    Label.TextWrapped = true
    Label.Font = Enum.Font.GothamBold
    Label.Parent = Billboard

    Scanner.LocationMarkers[FishID] = Marker

    return Marker
end

local function UpdatePersistentMarker(FishID)
    if not ENABLE_LAST_KNOWN_LOCATION then
        return
    end

    local Location = Scanner.LastKnownLocations[FishID]

    if not Location then
        return
    end

    local Marker = CreatePersistentMarker(FishID)

    if not Marker then
        return
    end

    Marker.Position = Location.Position

    local Billboard = Marker:FindFirstChild("LocationLabel")
    local Label = Billboard and Billboard:FindFirstChild("Label")

    if Label then
        Label.Text = Location.Name
            .. "\n" .. tostring(Location.Rarity or "Unknown")
            .. "\nLAST KNOWN LOCATION"
            .. "\n" .. string.format(
                "%.1f, %.1f, %.1f",
                Location.Position.X,
                Location.Position.Y,
                Location.Position.Z
            )
    end
end

local function SaveFishPosition(FishID, Hitbox, Name, Rarity, Mutation)
    if not ENABLE_LAST_KNOWN_LOCATION then
        return
    end

    if not Hitbox or not Hitbox:IsA("BasePart") then
        return
    end

    local IsAether = Mutation == "Aether"
    local IsDivine = Rarity == "Divine Secret"

    if not IsAether and not IsDivine then
        return
    end

    Scanner.LastKnownLocations[FishID] = {
        Position = Hitbox.Position,
        Name = Name,
        Rarity = Rarity,
        Mutation = Mutation
    }

    UpdatePersistentMarker(FishID)
end

--==================================================
-- HIGHLIGHT AND FLOATING TRACKER
--==================================================

local function HighlightFish(FishID, LabelText)
    if not Scanner.Running then
        return
    end

    local Hitbox = Scanner.SpawnedFish[FishID]

    if not Hitbox then
        return
    end

    local Model = GetFishModel(Hitbox)

    if not Model then
        return
    end

    if ENABLE_HIGHLIGHT then
        local Highlight = Model:FindFirstChild("AetherFishHighlight")

        if not Highlight then
            Highlight = Instance.new("Highlight")
            Highlight.Name = "AetherFishHighlight"
            Highlight.Adornee = Model
            Highlight.FillColor = Color3.fromRGB(170, 0, 255)
            Highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            Highlight.FillTransparency = 0.65
            Highlight.OutlineTransparency = 0
            Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            Highlight.Parent = Model
        end
    end

    if ENABLE_TRACKER then
        local Billboard = Model:FindFirstChild("AetherFishTracker")

        if not Billboard then
            Billboard = Instance.new("BillboardGui")
            Billboard.Name = "AetherFishTracker"
            Billboard.Size = UDim2.fromOffset(260, 65)
            Billboard.StudsOffset = Vector3.new(0, 4, 0)
            Billboard.AlwaysOnTop = true
            Billboard.Adornee = Hitbox
            Billboard.Parent = Model

            local TextLabel = Instance.new("TextLabel")
            TextLabel.Name = "FishLabel"
            TextLabel.Size = UDim2.fromScale(1, 1)
            TextLabel.BackgroundTransparency = 1
            TextLabel.TextColor3 = Color3.fromRGB(220, 150, 255)
            TextLabel.TextStrokeTransparency = 0
            TextLabel.TextScaled = true
            TextLabel.TextWrapped = true
            TextLabel.Font = Enum.Font.GothamBold
            TextLabel.Parent = Billboard
        end

        local TextLabel = Billboard:FindFirstChild("FishLabel")

        if TextLabel then
            TextLabel.Text = LabelText
        end

        Billboard.Adornee = Hitbox
    end
end

--==================================================
-- REMOVE VISUALS
--==================================================

local function RemoveFishVisuals(FishID)
    local Hitbox = Scanner.SpawnedFish[FishID]
    local Model = GetFishModel(Hitbox)

    if Model then
        local Highlight = Model:FindFirstChild("AetherFishHighlight")
        local Tracker = Model:FindFirstChild("AetherFishTracker")

        if Highlight then Highlight:Destroy() end
        if Tracker then Tracker:Destroy() end
    end
end

local function RemoveFish(FishID)
    RemoveFishVisuals(FishID)

    local Marker = Scanner.LocationMarkers[FishID]

    if Marker then
        Marker:Destroy()
    end

    Scanner.LocationMarkers[FishID] = nil
    Scanner.LastKnownLocations[FishID] = nil
    Scanner.FishDatabase[FishID] = nil
    Scanner.SpawnedFish[FishID] = nil
    Scanner.LastPrinted[FishID] = nil

    for Key in pairs(Scanner.Notified) do
        if string.find(
            Key,
            tostring(FishID) .. "_",
            1,
            true
        ) == 1 then
            Scanner.Notified[Key] = nil
        end
    end
end

--==================================================
-- REPORT FISH AND ALERTS
--==================================================

local function ReportFish(FishID)
    if not Scanner.Running then
        return
    end

    local Data = Scanner.FishDatabase[FishID]

    if not Data then
        return
    end

    local Hitbox = Scanner.SpawnedFish[FishID]

    local Name = Data.Name
        or (Hitbox and Hitbox:GetAttribute("FishName"))
        or "Unknown"

    local Rarity = GetRarity(Name)

    local Parts = {
        "UID: " .. tostring(FishID),
        "Fish: " .. tostring(Name)
    }

    if Rarity ~= nil then
        table.insert(Parts, "Rarity: " .. tostring(Rarity))
    end

    if Data.Mutation ~= nil then
        table.insert(Parts, "Mutation: " .. tostring(Data.Mutation))
    end

    if Data.Hat ~= nil then
        table.insert(Parts, "Hat: " .. tostring(Data.Hat))
    end

    local Message = table.concat(Parts, " | ")

    if Scanner.LastPrinted[FishID] ~= Message then
        Scanner.LastPrinted[FishID] = Message
        print("[FISH] " .. Message)
    end

    local IsAether = Data.Mutation == "Aether"
    local IsDivine = Rarity == "Divine Secret"

    if IsAether or IsDivine then
        local LabelText = Name
            .. "\n" .. tostring(Rarity or "Unknown")

        if Data.Mutation then
            LabelText = LabelText
                .. " | " .. tostring(Data.Mutation)
        end

        if Hitbox then
            HighlightFish(FishID, LabelText)

            SaveFishPosition(
                FishID,
                Hitbox,
                Name,
                Rarity,
                Data.Mutation
            )
        end
    end

    -- Aether notification
    if IsAether then
        local AlertKey = tostring(FishID) .. "_Aether"

        if not Scanner.Notified[AlertKey] then
            Scanner.Notified[AlertKey] = true

            task.spawn(function()
                pcall(function()
                    SendNotification("AETHER FOUND!\n" .. Name, 15)
                end)
            end)
        end
    end

    -- Divine Secret notification
    if IsDivine then
        local AlertKey = tostring(FishID) .. "_DivineSecret"

        if not Scanner.Notified[AlertKey] then
            Scanner.Notified[AlertKey] = true

            task.spawn(function()
                pcall(function()
                    SendNotification("DIVINE SECRET FOUND!\n" .. Name, 15)
                end)
            end)
        end
    end
end

--==================================================
-- REMOTE DATA UPDATES
--==================================================

Scanner.Connections.Remote = Event.OnClientEvent:Connect(function(UpdateTable)
    if not Scanner.Running then
        return
    end

    for FishID, Data in pairs(UpdateTable) do
        if Data == 0 then
            RemoveFish(FishID)
            print("[FISH DESPAWNED]", FishID)

        elseif typeof(Data) == "table" then
            local Existing = Scanner.FishDatabase[FishID]

            if not Existing then
                Existing = {
                    Name = nil,
                    Mutation = nil,
                    Hat = nil
                }

                Scanner.FishDatabase[FishID] = Existing
            end

            if Data.f ~= nil then
                Existing.Name = Data.f
            end

            if Data.m ~= nil then
                Existing.Mutation = Data.m
            end

            if Data.h ~= nil then
                Existing.Hat = Data.h
            end

            ReportFish(FishID)
        end
    end
end)

--==================================================
-- FISH MODEL DETECTION
--==================================================

local function CheckObject(Object)
    if not Scanner.Running then
        return
    end

    if not Object:IsA("BasePart") then
        return
    end

    local FishID = Object:GetAttribute("UID")

    if not FishID then
        return
    end

    Scanner.SpawnedFish[FishID] = Object

    local Existing = Scanner.FishDatabase[FishID]

    if not Existing then
        Existing = {
            Name = Object:GetAttribute("FishName"),
            Mutation = nil,
            Hat = nil
        }

        Scanner.FishDatabase[FishID] = Existing

    elseif not Existing.Name then
        Existing.Name = Object:GetAttribute("FishName")
    end

    -- Restore existing last-known marker if model returns
    if Scanner.LastKnownLocations[FishID] then
        UpdatePersistentMarker(FishID)
    end

    ReportFish(FishID)
end

-- Scan existing fish
for _, Object in ipairs(FishFolder:GetDescendants()) do
    CheckObject(Object)
end

-- Detect newly spawned fish
Scanner.Connections.Spawned =
    FishFolder.DescendantAdded:Connect(CheckObject)

--==================================================
-- CONTINUOUS POSITION SAMPLING
--==================================================

local Accumulator = 0

Scanner.Connections.PositionUpdate =
    RunService.Heartbeat:Connect(function(DeltaTime)

    if not Scanner.Running then
        return
    end

    Accumulator = Accumulator + DeltaTime

    if Accumulator < LOCATION_UPDATE_INTERVAL then
        return
    end

    Accumulator = 0

    for FishID, Hitbox in pairs(Scanner.SpawnedFish) do
        if Hitbox and Hitbox.Parent then
            local Data = Scanner.FishDatabase[FishID]

            if Data and IsSpecial(Data) then
                local Name = Data.Name
                    or Hitbox:GetAttribute("FishName")
                    or "Unknown"

                local Rarity = GetRarity(Name)

                SaveFishPosition(
                    FishID,
                    Hitbox,
                    Name,
                    Rarity,
                    Data.Mutation
                )
            end
        else
            -- Model may have streamed out.
            -- Keep the last known location and marker.
            Scanner.SpawnedFish[FishID] = nil
        end
    end

    -- Recreate markers if the game deletes them
    for FishID, Location in pairs(Scanner.LastKnownLocations) do
        if not Scanner.LocationMarkers[FishID]
            or not Scanner.LocationMarkers[FishID].Parent then

            Scanner.LocationMarkers[FishID] = nil
            UpdatePersistentMarker(FishID)
        end
    end
end)

--==================================================
-- DISCONNECT
--==================================================

Scanner.Disconnect = function()
    if not Scanner.Running then
        return
    end

    Scanner.Running = false

    for _, Connection in pairs(Scanner.Connections) do
        pcall(function()
            Connection:Disconnect()
        end)
    end

    for _, Marker in pairs(Scanner.LocationMarkers) do
        pcall(function()
            Marker:Destroy()
        end)
    end

    if Scanner.MarkerFolder then
        Scanner.MarkerFolder:Destroy()
    end

    for FishID in pairs(Scanner.SpawnedFish) do
        RemoveFishVisuals(FishID)
    end

    table.clear(Scanner.Connections)

    if Env.AetherFishScanner == Scanner then
        Env.AetherFishScanner = nil
    end

    print("[FISH SCANNER] Fully disconnected.")
end

print("[FISH SCANNER] Running!")
print("[FISH SCANNER] Aether and Divine Secret detection enabled.")
print("[FISH SCANNER] Highlights and floating trackers enabled.")
print("[FISH SCANNER] Persistent last-known location tracking enabled.")
