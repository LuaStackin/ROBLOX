
local Env = getgenv()

--==================================================
-- CLEAN UP PREVIOUS INSTANCE
--==================================================

if Env.AetherFishScanner then
    local Previous = Env.AetherFishScanner

    Previous.Running = false

    for _, Connection in pairs(Previous.Connections or {}) do
        pcall(function()
            Connection:Disconnect()
        end)
    end

    print("[AETHER SCANNER] Previous instance disconnected.")
end

--==================================================
-- SERVICES AND REFERENCES
--==================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Event = ReplicatedStorage
    .packages.Net["RE/RoamingFish/Update"]

local FishFolder = Workspace
    .active:WaitForChild("roamingFish")

--==================================================
-- SCANNER STATE
--==================================================

local Scanner = {
    Running = true,

    Connections = {},

    FishDatabase = {},
    SpawnedFish = {},
    LastPrinted = {}
}

Env.AetherFishScanner = Scanner

--==================================================
-- REPORT FISH
--==================================================

local function ReportFish(FishID)
    if not Scanner.Running then
        return
    end

    local Data = Scanner.FishDatabase[FishID]

    if not Data then
        return
    end

    local Hitbox = Scanner.SpawnedFish[FishID]

    local Name = Data.Name
        or (Hitbox and Hitbox:GetAttribute("FishName"))
        or "Unknown"

    local Mutation

    if Data.MutationKnown then
        Mutation = Data.Mutation or "None"
    else
        Mutation = "Unknown"
    end

    local Hat

    if Data.HatKnown then
        Hat = Data.Hat or "None"
    else
        Hat = "Unknown"
    end

    local Result = string.format(
        "%s|%s|%s",
        tostring(Name),
        tostring(Mutation),
        tostring(Hat)
    )

    -- Prevent duplicate output
    if Scanner.LastPrinted[FishID] == Result then
        return
    end

    Scanner.LastPrinted[FishID] = Result

    local Message = string.format(
        "UID: %s | Fish: %s | Mutation: %s | Hat: %s",
        tostring(FishID),
        tostring(Name),
        tostring(Mutation),
        tostring(Hat)
    )

    if Mutation == "Aether" then
        warn("[AETHER FOUND] " .. Message)

    elseif Hat ~= "None" and Hat ~= "Unknown" then
        warn("[HAT FOUND] " .. Message)

    else
        print("[FISH] " .. Message)
    end
end

--==================================================
-- REMOTE EVENT DATA
--==================================================

Scanner.Connections.Remote = Event.OnClientEvent:Connect(function(UpdateTable)
    if not Scanner.Running then
        return
    end

    for FishID, Data in pairs(UpdateTable) do

        -- Fish removed
        if Data == 0 then
            Scanner.FishDatabase[FishID] = nil
            Scanner.SpawnedFish[FishID] = nil
            Scanner.LastPrinted[FishID] = nil

            print("[FISH DESPAWNED]", FishID)

        elseif typeof(Data) == "table" then

            local Existing = Scanner.FishDatabase[FishID]

            -- Create database entry
            if not Existing then
                Existing = {
                    Name = nil,

                    Mutation = nil,
                    MutationKnown = false,

                    Hat = nil,
                    HatKnown = false
                }

                Scanner.FishDatabase[FishID] = Existing
            end

            -- Fish name / initial fish packet
            if Data.f ~= nil then
                Existing.Name = Data.f

                -- Initial packet provides initial mutation
                if not Existing.MutationKnown then
                    Existing.Mutation = Data.m
                    Existing.MutationKnown = true
                end

                -- Initial packet provides initial hat
                if not Existing.HatKnown then
                    Existing.Hat = Data.h
                    Existing.HatKnown = true
                end
            end

            -- Mutation update
            if Data.m ~= nil then
                Existing.Mutation = Data.m
                Existing.MutationKnown = true
            end

            -- Hat update
            if Data.h ~= nil then
                Existing.Hat = Data.h
                Existing.HatKnown = true
            end

            ReportFish(FishID)
        end
    end
end)

--==================================================
-- WORKSPACE FISH DETECTION
--==================================================

local function CheckObject(Object)
    if not Scanner.Running then
        return
    end

    if not Object:IsA("BasePart") then
        return
    end

    local FishID = Object:GetAttribute("UID")

    if not FishID then
        return
    end

    Scanner.SpawnedFish[FishID] = Object

    local Existing = Scanner.FishDatabase[FishID]

    if not Existing then
        Existing = {
            Name = Object:GetAttribute("FishName"),

            Mutation = nil,
            MutationKnown = false,

            Hat = nil,
            HatKnown = false
        }

        Scanner.FishDatabase[FishID] = Existing

    elseif not Existing.Name then
        Existing.Name = Object:GetAttribute("FishName")
    end

    ReportFish(FishID)
end

--==================================================
-- CHECK ALREADY SPAWNED FISH
--==================================================

for _, Object in ipairs(FishFolder:GetDescendants()) do
    CheckObject(Object)
end

--==================================================
-- DETECT NEWLY SPAWNED FISH
--==================================================

Scanner.Connections.Spawned =
    FishFolder.DescendantAdded:Connect(CheckObject)

--==================================================
-- MANUAL DISCONNECT FUNCTION
--==================================================

Scanner.Disconnect = function()
    if not Scanner.Running then
        return
    end

    Scanner.Running = false

    for _, Connection in pairs(Scanner.Connections) do
        pcall(function()
            Connection:Disconnect()
        end)
    end

    table.clear(Scanner.Connections)

    if Env.AetherFishScanner == Scanner then
        Env.AetherFishScanner = nil
    end

    print("[AETHER SCANNER] Fully disconnected.")
end

print("[AETHER SCANNER] Running!")
print("[AETHER SCANNER] Monitoring fish, mutations and hats.")
print("[AETHER SCANNER] Execute again to replace this instance.")
